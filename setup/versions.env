# Versions used by setup/02-install.sh and setup/prepull-images.sh.
# This exact combination ran the full demo end to end (November 2026).
# Override any of them from the environment, for example:
#   CILIUM_VERSION=1.19.11 setup/02-install.sh

# k3s v1.33: the newest Kubernetes release Cilium 1.18 is tested against.
K3S_CHANNEL=${K3S_CHANNEL:-v1.33}
# Fallback if Cilium 1.18 misbehaves on your kernel: 1.19.11 (supports k8s 1.32-1.35).
CILIUM_VERSION=${CILIUM_VERSION:-1.18.17}
TETRAGON_VERSION=${TETRAGON_VERSION:-1.8.0}

# Helm flags for Cilium on k3s.
# useDigest=false lets Cilium use images pre-pulled with podman (see prepull-images.sh).
CILIUM_HELM_ARGS=(
  --set operator.replicas=1
  --set ipam.operator.clusterPoolIPv4PodCIDRList=10.42.0.0/16
  --set image.useDigest=false
  --set operator.image.useDigest=false
  --set envoy.image.useDigest=false
)
